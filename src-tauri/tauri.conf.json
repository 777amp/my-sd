{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Signal",
  "version": "8.39.0",
  "identifier": "org.signal.desktop",
  "build": {
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Signal",
        "url": "index.html",
        "width": 1024,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "visible": true,
        "decorations": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/**", "$APPCONFIG/**"]
      },
      "csp": "default-src 'none'; child-src 'self'; connect-src 'self' https: wss: attachment: asset: bundles: ipc: http://ipc.localhost blob:; font-src 'self' asset: http://asset.localhost; form-action 'self'; frame-src 'none'; img-src 'self' blob: data: emoji: attachment: asset: http://attachment.localhost http://asset.localhost http://emoji.localhost; media-src 'self' blob: attachment: http://attachment.localhost; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "../build/icons/png/32x32.png",
      "../build/icons/png/128x128.png",
      "../build/icons/png/256x256.png",
      "../build/icons/png/512x512.png"
    ],
    "resources": {
      "../config/default.json": "config/default.json",
      "../config/production.json": "config/production.json",
      "../sidecar/signal-sidecar.mjs": "sidecar/signal-sidecar.mjs"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libasound2 | libasound2t64",
          "libsecret-1-0",
          "nodejs"
        ],
        "section": "net",
        "priority": "optional",
        "desktopTemplate": null
      }
    }
  }
}
